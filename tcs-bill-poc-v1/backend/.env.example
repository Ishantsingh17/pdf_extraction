# Copy this file to backend/.env and edit. Real environment variables win
# over anything set here. Restart the backend after changing it.
#
# Check what is actually active:  curl http://127.0.0.1:8000/api/v1/health

# --- Document processing engines -------------------------------------------

# Layout analysis.
#   geometric   - deterministic, ~1 ms/page (default)
#   layout      - PP-DocLayout_plus-L on its own, ~7 s/page
#   ppstructure - the full PP-StructureV3 pipeline, ~84 s/page, finest regions
#   auto        - the layout model if installed, else geometric
STRUCTURE_ENGINE=geometric

# OCR for images and scanned PDFs.
#   auto      - Tesseract first, then PaddleOCR (default)
#   tesseract - Tesseract only, ~0.8 s/page
#   paddleocr - PP-OCRv5 only, ~50 s/page, needs the Paddle packages
OCR_ENGINE=auto

# Leave false on Windows: paddlepaddle 3.3.1 crashes in its oneDNN path.
PADDLE_ENABLE_MKLDNN=false

# Longest side of the image PP-StructureV3 hands its text detector. Above
# ~1 MP, PP-OCRv5_server_det segfaults paddlepaddle 3.3.1 on Windows CPU and
# takes the API worker with it. Only raise this if you have verified it.
# PADDLE_TEXT_DET_MAX_SIDE=960

# --- Everything below is optional -------------------------------------------

# MAX_FILE_SIZE_BYTES=10485760
# CONFIDENCE_HIGH=0.90
# CONFIDENCE_REVIEW=0.70
# DATABASE_URL=sqlite:///C:/path/to/poc.db
